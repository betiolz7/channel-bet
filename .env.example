# Arquivo OAuth baixado do Google Cloud Console (tipo "Aplicativo da Web")
GOOGLE_CLIENT_SECRETS=client_secret.json

# Endereço onde o app roda. O redirect OAuth será BASE_URL + /oauth/callback
BASE_URL=http://localhost:8000

# API do MoneyPrinterTurbo (geração de vídeo). Deixe como está se rodar localmente.
MPT_URL=http://127.0.0.1:8080

# Pasta onde ficam o banco SQLite e os vídeos
DATA_DIR=data

# Intervalo do worker em segundos e frequência da coleta de estatísticas em horas
WORKER_INTERVAL_SECONDS=30
STATS_REFRESH_HOURS=6

# (Opcional) Chave da Anthropic para sugerir título, descrição e tags com IA
# Crie em https://console.anthropic.com/
ANTHROPIC_API_KEY=

# (Opcional) Instagram: app criado em https://developers.facebook.com/ (veja o README)
META_APP_ID=
META_APP_SECRET=
# ID da configuração do "Login do Facebook para Empresas" (deixe vazio para usar escopos)
META_CONFIG_ID=
META_API_VERSION=v24.0
